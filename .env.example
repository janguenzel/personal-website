# ─────────────────────────────────────────────────────────────────────────────
# jan-guenzel.de — Terminal Portfolio · environment configuration
#
# Copy this file to `.env.local` for local development, or set these in your
# host's dashboard (e.g. Vercel) for production. Everything has a safe example
# default, so the site runs out-of-the-box with placeholder ("John Doe") data
# and nothing personal is ever committed to git.
#
#   NEXT_PUBLIC_*  → exposed to the browser (powers SEO tags + the landing page)
#   everything else → server-only (secrets, OAuth, legal/imprint details)
#
# Values shown after "=" are the built-in defaults; uncomment + edit to override.
# ─────────────────────────────────────────────────────────────────────────────


# ── Public site identity (lib/site.ts) ──────────────────────────────────────
# Canonical absolute URL, no trailing slash. Used for SEO, sitemap, OG images,
# and the GitHub OAuth redirect URI — set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display name (title bar, fastfetch, metadata, JSON-LD Person).
NEXT_PUBLIC_SITE_NAME=John Doe

# Shell hostname in the prompt, e.g. "visitor@portfolio".
NEXT_PUBLIC_SITE_HOST=portfolio

# Shell username in the prompt.
NEXT_PUBLIC_SITE_USER=visitor

# Role / title shown in fastfetch.
NEXT_PUBLIC_SITE_ROLE=Software Engineer

# Location shown in fastfetch.
NEXT_PUBLIC_SITE_LOCATION=Earth

# Public contact address shown on the landing page.
NEXT_PUBLIC_SITE_EMAIL=john.doe@example.com

# GitHub username — drives the GitHub social link.
NEXT_PUBLIC_GITHUB_USER=octocat

# Optional socials — leave empty to hide the link.
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_LINKEDIN_URL=

# Fastfetch flavour text.
NEXT_PUBLIC_SITE_DISTRO=PortfolioOS 1.0 (terminal edition)
NEXT_PUBLIC_SITE_SHELL=zsh
NEXT_PUBLIC_SITE_EDITOR=vscode, neovim

# Comma-separated lists shown in fastfetch.
NEXT_PUBLIC_SITE_LANGUAGES=TypeScript,Rust,Python
NEXT_PUBLIC_SITE_STACK=Next.js,React,Node.js,Nest.js,PostgreSQL,Docker

# ISO date you started coding — drives the fastfetch "uptime" counter.
NEXT_PUBLIC_CODING_SINCE=2015-01-01


# ── GitHub OAuth (lib/auth/github.ts) ────────────────────────────────────────
# Register an OAuth App at https://github.com/settings/developers with the
# callback URL  <NEXT_PUBLIC_SITE_URL>/api/auth/callback
# Leave both empty to disable the message board's sign-in (board becomes read-only).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ── Session signing (lib/auth/session.ts) ────────────────────────────────────
# Secret used to HMAC-sign the session cookie. REQUIRED in production (the app
# throws on boot without it). Generate one with:  openssl rand -hex 32
AUTH_SECRET=


# ── Board + visitor-counter storage (lib/board/store.ts, lib/visits/store.ts) ─
# When set, messages and the visit count persist to Neon Postgres; otherwise they
# fall back to local JSON files under .data/ (development only).
# Recommended for most uses
DATABASE_URL=

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=

# Parameters for constructing your own connection string
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Parameters for Vercel Postgres Templates
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# ── Legal / imprint details — SERVER-ONLY (lib/imprint.ts) ────────────────────
# Rendered into the /imprint and /privacy pages (both noindex). Never exposed to
# the browser. Set your real details here in production. While IMPRINT_NAME is
# empty the imprint page shows a "not configured" placeholder.
IMPRINT_NAME=
IMPRINT_STREET=Example Street 1
IMPRINT_CITY=12345 Example City
IMPRINT_COUNTRY=Germany
# Falls back to NEXT_PUBLIC_SITE_EMAIL, then mail@example.com, if unset.
IMPRINT_EMAIL=
IMPRINT_PHONE=
IMPRINT_VAT_ID=
